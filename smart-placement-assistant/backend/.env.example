# Copy to .env and fill in. NEVER commit .env
DB_USER=root
DB_PASSWORD=""
DB_HOST=localhost
DB_PORT=3306
DB_NAME=placement_assistant
# Optional: full URL overrides the DB_* values (e.g. sqlite:///./dev.db for quick local tests)
# DATABASE_URL=
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
AUTO_SEED=true
SEED_ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=
